# 行尾统一：所有文本文件在仓库中一律使用 LF。
# 本机 git 全局配置为 core.autocrlf=true，本文件的规则优先于它，
# 用于消除「LF will be replaced by CRLF」一类告警与跨平台行尾漂移。
* text=auto eol=lf

# Windows 专用脚本必须保留 CRLF，否则 cmd.exe 可能无法执行
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# 二进制文件：禁止任何行尾与编码转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary

# 锁文件比较大，diff 无意义，标记为生成物
pnpm-lock.yaml linguist-generated=true
