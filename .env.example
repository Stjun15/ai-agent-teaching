# ============================================================================
# 环境变量模板
#
# 用法：复制为 .env.local 后填入真实值
#     cp .env.example .env.local
#
# ⚠️ 铁律：API Key 绝不落盘。
#   本文件只放「变量名 + 占位符」，不要在这里填真实密钥；
#   本地复制出来的 .env.local 同样不要提交（已被 .gitignore 排除）。
# ============================================================================

# ---------------------------------------------------------------------------
# 模型平台：火山方舟 Volcengine Ark（OpenAI 兼容端点 /v1）
# 控制台：https://platform.ark.cn
# ---------------------------------------------------------------------------

# API 密钥。请在本地 .env.local 中填写，不要写进本文件
ARK_API_KEY=your-ark-api-key

# 可选。默认即为下方地址，通常无需修改
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# 主模型（文本推理）— DeepSeek V4 Flash，原生多模态
ARK_TEXT_MODEL=deepseek-v4-flash-ga-260731

# 多模态模型（视觉理解）— 豆包视觉模型
ARK_VISION_MODEL=doubao-seed-2-1-pro-260915

# ---------------------------------------------------------------------------
# 鉴权
# ---------------------------------------------------------------------------

# JWT 令牌签名密钥。生产环境务必替换为随机强密钥。
AUTH_SECRET=ai-teaching-dev-secret-change-in-production

# ---------------------------------------------------------------------------
# 数据库
# ---------------------------------------------------------------------------

# 开发期：本地 SQLite 文件（文件本身不入库）
DATABASE_URL=file:./dev.db

# 部署期：CloudBase PostgreSQL（Phase 7 启用后改用下面这行）
# DATABASE_URL=postgresql://user:password@host:5432/dbname